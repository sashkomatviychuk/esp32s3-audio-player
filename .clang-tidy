Checks: >
  -*,
  readability-*,
  bugprone-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -bugprone-easily-swappable-parameters

WarningsAsErrors: ""

HeaderFilterRegex: "^(src|include)/.*"

CheckOptions:
  # Functions: not enforced (ESP-IDF snake_case by convention)
  - key: readability-identifier-naming.FunctionCase
    value: aNy_CasE

  # Variables: snake_case (spi_mutex, cmd_queue)
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  # ESP-IDF logging tag (static const char* TAG) is a conventional exception
  - key: readability-identifier-naming.VariableIgnoredRegexp
    value: '^TAG$'

  # File-scope constant tables are UPPER_CASE (ICON_PLAY, BITRATE_MPEG1_L3)
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  # ...except s_-prefixed module-private statics (s_views dispatch table)
  - key: readability-identifier-naming.GlobalConstantIgnoredRegexp
    value: '^s_[a-z0-9_]+$'
  - key: readability-identifier-naming.StaticConstantIgnoredRegexp
    value: '^s_[a-z0-9_]+$'

  # Macros and constants: UPPER_CASE (VS1053_PIN_CS, DISPLAY_WIDTH)
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE

  # Structs/typedefs: not enforced (snake_case with _t suffix by convention)
  - key: readability-identifier-naming.TypedefCase
    value: aNy_CasE
  - key: readability-identifier-naming.StructCase
    value: aNy_CasE

  - key: readability-function-cognitive-complexity.Threshold
    value: 50
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: 'true'
